{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "allowJs": true
  },
  "include": [".", "../../vitest.config.ts", "../../src/texts/uk.ts", "../../src/texts/index.ts", "../../src/config.ts"]
}
