{
  "name": "adhd-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/node/tsconfig.json",
    "test": "vitest run",
