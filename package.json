  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@types/node": "^24.19.2",
    "smol-toml": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "grammy": "^1.46.0"
  }
}
